{
  "name": "verbo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gate": "node tools/evidence/ac-gate.mjs",
    "verify": "npm run typecheck && npm test && npm run test:browser && npm run gate",
    "evidence": "node tools/evidence/report.mjs --write",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:browser": "playwright test",
    "verify:fast": "npm run typecheck && npm test && npm run gate",
    "eval": "node tools/eval/nightly.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "@types/three": "^0.185.4",
    "acorn": "^8.14.0",
    "acorn-walk": "^8.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "three": "^0.182.0"
  }
}
