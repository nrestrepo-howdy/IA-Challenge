{
  "name": "verbo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gate": "node tools/evidence/ac-gate.mjs | tee .verbo/gate.txt",
    "verify": "npm run typecheck && npm test && npm run test:browser && npm run gate && node tools/evidence/record-verify.mjs ok || (node tools/evidence/record-verify.mjs fail && exit 1)",
    "evidence": "node tools/evidence/report.mjs --write",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:browser": "playwright test",
    "verify:fast": "npm run typecheck && npm test && npm run gate",
    "eval": "node tools/eval/nightly.mjs",
    "audit": "node tools/evidence/mutate-suite.mjs",
    "evidence:autonomy": "node tools/evidence/autonomy.mjs",
    "evidence:loop": "npx tsx tools/evidence/loop-trace.mts",
    "attack": "npx tsx tools/evidence/attacks.mts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "@types/three": "^0.185.4",
    "acorn": "^8.14.0",
    "acorn-walk": "^8.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "three": "^0.182.0",
    "zod": "^4.5.4"
  }
}
